## Standard Functions

### E₈ Root Generation
```python
def generate_d8_roots():
    """Generate 112 D₈-type roots: (±1,±1,0⁶) permutations."""
    roots = []
    for i in range(8):
        for j in range(i + 1, 8):
            for s1 in [+1.0, -1.0]:
                for s2 in [+1.0, -1.0]:
                    v = np.zeros(8)
                    v[i], v[j] = s1, s2
                    roots.append(v)
    return roots  # Should be 112

def generate_s8_roots():
    """Generate 128 S₈-type roots: ½(±1)⁸ with even minus signs."""
    roots = []
    for mask in range(256):
        bits = [(mask >> k) & 1 for k in range(8)]
        if sum(bits) % 2 == 0:  # even number of minuses
            v = np.array([0.5 * (1 - 2*b) for b in bits])
            roots.append(v)
    return roots  # Should be 128
```

### Golden Projection
```python
def build_golden_projection():
    """Build the 4×8 golden projection matrix (orthonormalized)."""
    phi = (1.0 + np.sqrt(5.0)) / 2.0
    phi_inv = 1.0 / phi
    
    # Moxness basis
    x = np.array([1, phi, 0, -1, phi, 0, 0, 0])
    y = np.array([phi, 0, 1, phi, 0, -1, 0, 0])
    z = np.array([0, 1, phi, 0, -1, phi, 0, 0])
    w = np.array([0, 0, 0, 0, 0, 0, phi**2, phi_inv])
    
    M = np.vstack([x, y, z, w])
    Q, R = np.linalg.qr(M.T)
    P = Q.T  # 4×8, orthonormal rows
    
    # Verify orthonormality
    assert np.allclose(P @ P.T, np.eye(4), atol=1e-10)
    return P
```

